From bf0f27b157fd10e3a6af6def8f87600356cad018 Mon Sep 17 00:00:00 2001
From: Super User <root@pc-11278.home>
Date: Thu, 13 Mar 2025 10:25:13 +0100
Subject: [PATCH 05/13] xen/configs: introduce mtcollins configs

Signed-off-by: Yann Dirson <yann.dirson@vates.tech>
Signed-off-by: Julian Vetter <julian.vetter@vates.tech>
---
 buildconfigs/config-debug-mtcollins   | 50 +++++++++++++++++++++++++++
 buildconfigs/config-release-mtcollins | 50 +++++++++++++++++++++++++++
 2 files changed, 100 insertions(+)
 create mode 100644 buildconfigs/config-debug-mtcollins
 create mode 100644 buildconfigs/config-release-mtcollins

diff --git a/buildconfigs/config-debug-mtcollins b/buildconfigs/config-debug-mtcollins
new file mode 100644
index 0000000000..cc0e70838f
--- /dev/null
+++ b/buildconfigs/config-debug-mtcollins
@@ -0,0 +1,50 @@
+CONFIG_ARM_64=y
+CONFIG_ARM=y
+
+#
+# Architecture Features
+CONFIG_GICV3=y
+# CONFIG_MEM_ACCESS is not set
+#VUART_CONSOLE is not set
+
+#
+# Common Features
+#
+CONFIG_SCHED_CREDIT=
+# CONFIG_SCHED_CREDIT2 is not set
+# CONFIG_SCHED_RTDS is not set
+# CONFIG_SCHED_ARINC653 is not set
+# CONFIG_SCHED_NULL is not set
+# CONFIG_SUPPRESS_DUPLICATE_SYMBOL_WARNING#
+# Device Drivers
+#
+# CONFIG_HAS_NS16550 is not set
+# CONFIG_HAS_CADENCE_UART is not set
+# CONFIG_HAS_MVEBU is not set
+# CONFIG_HAS_PL011 is not set
+# CONFIG_HAS_SCIF is not set
+# CONFIG_ARM_SMMU is not set
+
+#
+# Debugging Options
+#
+CONFIG_DEBUG=y
+CONFIG_FRAME_POINTER=y
+CONFIG_VERBOSE_DEBUG=y
+CONFIG_SCRUB_DEBUG=y
+#
+
+CONFIG_VERBOSE_DEBUG=y
+CONFIG_EARLY_UART_CHOICE_PL011=y
+CONFIG_EARLY_UART_PL011=y
+CONFIG_EARLY_PRINTK=y
+CONFIG_EARLY_UART_BASE_ADDRESS=0x100002600000
+CONFIG_EARLY_UART_PL011_BAUD_RATE=0
+CONFIG_EARLY_UART_PL011_MMIO32=y
+CONFIG_EARLY_PRINTK_INC="debug-pl011.inc"
+CONFIG_HAS_PL011=y
+CONFIG_EXPERT=y
+CONFIG_ACPI=y
+CONFIG_NR_CPUS=160
+
+CONFIG_HAS_ITS=y
diff --git a/buildconfigs/config-release-mtcollins b/buildconfigs/config-release-mtcollins
new file mode 100644
index 0000000000..a13c2797a6
--- /dev/null
+++ b/buildconfigs/config-release-mtcollins
