From 0e976926440e987ae3fa09f712d294be3b5040de Mon Sep 17 00:00:00 2001
From: Andrii Sultanov <andriy.sultanov@vates.tech>
Date: Tue, 3 Mar 2026 14:42:14 +0000
Subject: [PATCH] mmu/pm2.c: Add ENOMEM logging

Signed-off-by: Andrii Sultanov <andriy.sultanov@vates.tech>
---
 tools/xenguest/xenguest_stubs.c |  2 ++
 xen/arch/arm/mmu/p2m.c          | 29 ++++++++++++++++++++++++++++-
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/tools/xenguest/xenguest_stubs.c b/tools/xenguest/xenguest_stubs.c
index 626ca43a46..fedff075a5 100644
--- a/tools/xenguest/xenguest_stubs.c
+++ b/tools/xenguest/xenguest_stubs.c
@@ -1498,6 +1498,8 @@ static int pvh_setup_mem(struct xc_dom_image *dom, uint64_t max_mem_mib,
 
     if ( xc_dom_mem_init(dom, max_mem_mib) )
         failwith_oss_xc("xc_dom_mem_init");
+    if ( xc_set_paging_mempool_size(xch, domid, 3000 << XC_PAGE_SHIFT) )
+        failwith_oss_xc("xc_set_paging_mempool_size");
     if ( xc_dom_boot_mem_init(dom) )
         failwith_oss_xc("xc_dom_boot_mem_init");
 
diff --git a/xen/arch/arm/mmu/p2m.c b/xen/arch/arm/mmu/p2m.c
index 1725cca649..74dc8b5465 100644
--- a/xen/arch/arm/mmu/p2m.c
+++ b/xen/arch/arm/mmu/p2m.c
@@ -32,15 +32,21 @@ static struct page_info *p2m_alloc_page(struct domain *d)
      */
     if ( is_hardware_domain(d) )
     {
+        printk("ASVdebug: p2m_alloc_page hardware_domain\n");
         pg = alloc_domheap_page(NULL, 0);
-        if ( pg == NULL )
+        if ( pg == NULL ) {
+            printk("ASVdebug: p2m_alloc_page NULL\n");
             printk(XENLOG_G_ERR "Failed to allocate P2M pages for hwdom.\n");
+        }
     }
     else
     {
         spin_lock(&d->arch.paging.lock);
+        printk("ASVdebug: p2m_alloc_page else (%p)->next(%p), total_pages=%lu\n",
+                &d->arch.paging.p2m_freelist, d->arch.paging.p2m_freelist.next, d->arch.paging.p2m_total_pages);
         pg = page_list_remove_head(&d->arch.paging.p2m_freelist);
         spin_unlock(&d->arch.paging.lock);
+        printk("ASVdebug: p2m_alloc_page - pg %p\n", pg);
     }
 
     return pg;
@@ -76,6 +82,7 @@ int p2m_set_allocation(struct domain *d, unsigned long pages, bool *preempted)
 
     ASSERT(spin_is_locked(&d->arch.paging.lock));
 
+    printk("ASVdebug: p2m_set_allocation: pages=%lu, total_pages=%lu\n", pages, d->arch.paging.p2m_total_pages);
     for ( ; ; )
     {
         if ( d->arch.paging.p2m_total_pages < pages )
@@ -416,7 +423,10 @@ static int p2m_next_level(struct p2m_domain *p2m, bool read_only,
 
         ret = p2m_create_table(p2m, entry);
         if ( ret )
+        {
+            printk("ASVdebug: next_level p2m_create_table\n");
             return GUEST_TABLE_MAP_FAILED;
+        }
     }
 
     /* The function p2m_next_level is never called at the 3rd level */
@@ -707,7 +717,10 @@ static int p2m_create_table(struct p2m_domain *p2m, lpae_t *entry)
 
     page = p2m_alloc_page(p2m->domain);
     if ( page == NULL )
+    {
+        printk("ASVdebug: p2m_create_table NULL\n");
         return -ENOMEM;
+    }
 
     page_list_add(page, &p2m->pages);
 
@@ -986,7 +999,10 @@ static int __p2m_set_entry(struct p2m_domain *p2m,
 
     table = p2m_get_root_pointer(p2m, sgfn);
     if ( !table )
+    {
+        printk("ASVdebug: root_pointer\n");
         return -EINVAL;
+    }
 
     for ( level = P2M_ROOT_LEVEL; level < target; level++ )
     {
@@ -1006,6 +1022,7 @@ static int __p2m_set_entry(struct p2m_domain *p2m,
              * page table. In this case, just ignore it.
              */
             rc = removing_mapping ?  0 : -ENOENT;
+            printk("ASVdebug: GUEST_TABLE_MAP_FAILED\n");
             goto out;
         }
         else if ( rc != GUEST_TABLE_NORMAL_PAGE )
@@ -1037,6 +1054,7 @@ static int __p2m_set_entry(struct p2m_domain *p2m,
             p2m_free_entry(p2m, split_pte, level);
 
             rc = -ENOMEM;
+            printk("p2m_split_superpage ENOMEM\n");
             goto out;
         }
 
@@ -1090,7 +1108,10 @@ static int __p2m_set_entry(struct p2m_domain *p2m,
      */
     rc = p2m_mem_access_radix_set(p2m, sgfn, a);
     if ( rc )
+    {
+        printk("ASVdebug: access_radix_set\n");
         goto out;
+    }
 
     /*
      * Always remove the entry in order to follow the break-before-make
@@ -1147,6 +1168,8 @@ static int __p2m_set_entry(struct p2m_domain *p2m,
 
         rc = iommu_iotlb_flush(p2m->domain, _dfn(gfn_x(sgfn)),
                                1UL << page_order, flush_flags);
+        if ( rc )
+            printk("ASVdebug: iommu_iotlb_flush\n");
     }
     else
         rc = 0;
@@ -1181,7 +1204,10 @@ int p2m_set_entry(struct p2m_domain *p2m,
      * domain is dying.
      */
     if ( unlikely(p2m->domain->is_dying) )
+    {
+        printk("ASVdebug: p2m->domain->is_dying ENOMEM\n");
         return -ENOMEM;
+    }
 
     while ( nr )
     {
@@ -1521,6 +1547,7 @@ int p2m_init(struct domain *d)
     rwlock_init(&p2m->lock);
     spin_lock_init(&d->arch.paging.lock);
     INIT_PAGE_LIST_HEAD(&p2m->pages);
+    printk("ASVdebug: p2m_init\n");
     INIT_PAGE_LIST_HEAD(&d->arch.paging.p2m_freelist);
 
     p2m->vmid = INVALID_VMID;
