+ * ╒══════════════╧═════════════════════╧═══════════════════════╕ ◁│
  * │ vcpu_id                                                    │  │
  * ├────────────────────────────────────────────────────────────┤  │
  * │ pcpu_id                                                    │  │
@@ -207,25 +208,25 @@ DEFINE_XEN_GUEST_HANDLE(xen_pmu_arch_t);
  * ┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆┆  ┆
