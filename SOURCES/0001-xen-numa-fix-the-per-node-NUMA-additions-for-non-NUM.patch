From 47c07e03ec32709ac02bfff0f511c6eac330c87d Mon Sep 17 00:00:00 2001
From: Julian Vetter <julian.vetter@vates.tech>
Date: Mon, 8 Jun 2026 11:19:20 +0200
Subject: [PATCH 01/13] xen/numa: fix the per-node NUMA additions for non-NUMA
 builds

Arm does not select CONFIG_NUMA, which the per-node memory accounting
and the NUMA domctl added on top of Xen do not handle:

- struct domain has no node_tot_pages[] member without CONFIG_NUMA.
  Guard the per-node tracking in memory_exchange() with #ifdef
  CONFIG_NUMA and use a simple total_adjustment scalar for the non-NUMA
  path, so d->tot_pages is still correctly maintained.

- The non-NUMA numa_domctl stub returned -EOPNOTSUPP, while everything
  else in a non-NUMA build fakes a single node 0 (numainfo, node
  claims). Toolstacks reading a domain's per-node memory
  (XEN_DOMCTL_NUMA_OP_GET_NODE_PAGES), like xenopsd, thus failed on
  Arm. Implement the op for non-NUMA builds, reporting one node holding
  all of the domain's pages. The stub also broke the build, as struct
  domain and struct xen_domctl_numa_op are not in scope when numa.h is
  included, so declare numa_domctl() once for both configurations.

Signed-off-by: Julian Vetter <julian.vetter@vates.tech>
---
 xen/common/domctl.c    | 31 +++++++++++++++++++++++++++++++
 xen/common/memory.c    | 34 +++++++++++++++++++++++++++++++++-
 xen/include/xen/numa.h | 15 +++++++--------
 3 files changed, 71 insertions(+), 9 deletions(-)

diff --git a/xen/common/domctl.c b/xen/common/domctl.c
index c07d14a09b..3fe935c20b 100644
--- a/xen/common/domctl.c
+++ b/xen/common/domctl.c
@@ -307,6 +307,37 @@ void iocaps_double_unlock(struct domain *d, bool write)
         read_unlock(&d->caps_lock);
 }
 
+#ifndef CONFIG_NUMA
+/* Without NUMA, all of a domain's memory is on the single fake node 0. */
+int numa_domctl(
+    struct domain *d, struct xen_domctl_numa_op *numa, bool *copyback)
+{
+    struct node_pages *nodes = &numa->u.node_pages;
+    uint64_t tot_pages;
+
+    if ( numa->op != XEN_DOMCTL_NUMA_OP_GET_NODE_PAGES )
+        return -EOPNOTSUPP;
+
+    *copyback = true;
+
+    if ( nodes->nr_nodes )
+    {
+        nrspin_lock(&d->page_alloc_lock);
+        tot_pages = d->tot_pages;
+        nrspin_unlock(&d->page_alloc_lock);
+
+        if ( copy_to_guest(nodes->node_tot_pages, &tot_pages, 1) )
+        {
+            nodes->nr_nodes = 0;
+            return -EFAULT;
+        }
+    }
+
+    nodes->nr_nodes = 1;
+    return 0;
+}
+#endif
+
 static bool is_stable_domctl(uint32_t cmd)
 {
     return cmd == XEN_DOMCTL_get_domain_state;
diff --git a/xen/common/memory.c b/xen/common/memory.c
index fbd387787b..43a8f863ae 100644
--- a/xen/common/memory.c
+++ b/xen/common/memory.c
@@ -651,8 +651,12 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
     long          rc = 0;
     struct domain *d;
     struct page_info *page;
-    /* Shadow page count adjustments. */
+#ifdef CONFIG_NUMA
+    /* Shadow page count adjustments per NUMA node. */
     long node_tot_pages_adjustments[MAX_NUMNODES] = {};
+#else
+    long total_adjustment = 0;
+#endif
 
     if ( copy_from_guest(&exch, arg, 1) )
         return -EFAULT;
@@ -804,7 +808,11 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
 
                 page_list_add(page, &in_chunk_list);
                 /* Account the removed page for updating the per-node pages */
+#ifdef CONFIG_NUMA
                 node_tot_pages_adjustments[page_to_nid(page)]--;
+#else
+                total_adjustment--;
+#endif
 #ifdef CONFIG_X86
                 put_gfn(d, gmfn + k);
 #endif
@@ -865,6 +873,7 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
                  */
 
                 nrspin_lock(&d->page_alloc_lock);
+#ifdef CONFIG_NUMA
                 for_each_online_node ( k )
                 {
                     if ( !node_tot_pages_adjustments[k] )
@@ -883,6 +892,13 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
                     drop_dom_ref = !d->tot_pages;
                 }
                 ASSERT_NUMA_PAGE_COUNT(d);
+#else
+                if ( total_adjustment )
+                {
+                    d->tot_pages += total_adjustment;
+                    drop_dom_ref = !d->tot_pages;
+                }
+#endif
                 nrspin_unlock(&d->page_alloc_lock);
 
                 if ( drop_dom_ref )
@@ -892,8 +908,12 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
                 goto dying;
             }
             /* Account the assigned page for updating the per-node pages */
+#ifdef CONFIG_NUMA
             node_tot_pages_adjustments[page_to_nid(page)] +=
                 1 << exch.out.extent_order;
+#else
+            total_adjustment += 1 << exch.out.extent_order;
+#endif
 
             if ( __copy_from_guest_offset(&gpfn, exch.out.extent_start,
                                           (i << out_chunk_order) + j, 1) )
@@ -917,6 +937,7 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
         if ( rc )
             goto fail;
 
+#ifdef CONFIG_NUMA
         nrspin_lock(&d->page_alloc_lock);
         /* Success: Adjust d->node_tot_pages[]. d->tot_pages did not change. */
         for_each_online_node ( k )
@@ -926,6 +947,9 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
         nrspin_unlock(&d->page_alloc_lock);
         memset(node_tot_pages_adjustments, 0,
                sizeof(node_tot_pages_adjustments));
+#else
+        total_adjustment = 0;
+#endif
     }
 
     exch.nr_exchanged = exch.in.nr_extents;
@@ -952,7 +976,11 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
             free_domheap_page(page);
         }
         else
+#ifdef CONFIG_NUMA
             node_tot_pages_adjustments[page_to_nid(page)] += 1;
+#else
+            total_adjustment += 1;
+#endif
     }
 
     /*
@@ -960,6 +988,7 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
      * domain.
      */
     nrspin_lock(&d->page_alloc_lock);
+#ifdef CONFIG_NUMA
     for_each_online_node ( k )
     {
         if ( !node_tot_pages_adjustments[k] )
@@ -968,6 +997,9 @@ static long memory_exchange(XEN_GUEST_HANDLE_PARAM(xen_memory_exchange_t) arg)
         d->tot_pages += node_tot_pages_adjustments[k];
     }
     ASSERT_NUMA_PAGE_COUNT(d);
+#else
+    d->tot_pages += total_adjustment;
+#endif
     nrspin_unlock(&d->page_alloc_lock);
     ASSERT(page_list_empty(&out_chunk_list));
 
diff --git a/xen/include/xen/numa.h b/xen/include/xen/numa.h
index 6737ade864..6d0b0d3a48 100644
--- a/xen/include/xen/numa.h
+++ b/xen/include/xen/numa.h
@@ -3,6 +3,13 @@
 
 #include <xen/mm-frame.h>
 
+struct domain;
+
+struct xen_domctl_numa_op;
+
+extern int numa_domctl(
+    struct domain *d, struct xen_domctl_numa_op *numa, bool *copyback);
+
 #ifdef CONFIG_NUMA
 #include <xen/pdx.h>
 #include <asm/numa.h>
@@ -127,8 +134,6 @@ extern bool numa_memblks_available(void);
 extern bool numa_update_node_memblks(nodeid_t node, unsigned int arch_nid,
                                      paddr_t start, paddr_t size, bool hotplug);
 extern void numa_set_processor_nodes_parsed(nodeid_t node);
-extern int numa_domctl(
-    struct domain *d, struct xen_domctl_numa_op *numa, bool *copyback);
 
 #else
 
@@ -150,12 +155,6 @@ static inline nodeid_t mfn_to_nid(mfn_t mfn)
     return 0;
 }
 
-static inline int numa_domctl(
-    struct domain *d, struct xen_domctl_numa_op *numa, bool *copyback)
-{
-    return -EOPNOTSUPP;
-}
-
 #endif
 
 #define page_to_nid(pg) mfn_to_nid(page_to_mfn(pg))
