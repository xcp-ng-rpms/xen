From be27ec3b8e88187b84f2c5bf486b9d2e58e296fd Mon Sep 17 00:00:00 2001
From: Julian Vetter <julian.vetter@vates.tech>
Date: Thu, 25 Jun 2026 11:35:36 +0200
Subject: [PATCH] xen/numa: add missing headers for non-NUMA numa_domctl stub

On aarch64 CONFIG_NUMA is not set, so the #else stub is compiled for
any TU that includes numa.h. The stub uses EOPNOTSUPP, struct
xen_domctl_numa_op, and struct domain, none of which are in scope via
the asm-offsets.c -> sched.h -> domain.h -> numa.h include chain
(domain.h includes numa.h before struct domain is declared).

Without a forward declaration, struct domain used as a parameter of a
function *definition* (not just a prototype) is only visible inside
that parameter list, which GCC flags under -Werror:

    numa.h:159:12: error: 'struct domain' declared inside parameter
    list will not be visible outside of this definition or
    declaration [-Werror]

Add xen/errno.h for EOPNOTSUPP and forward declarations for struct
domain and struct xen_domctl_numa_op to fix the build.

Signed-off-by: Julian Vetter <julian.vetter@vates.tech>
---
 xen/include/xen/numa.h | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/xen/include/xen/numa.h b/xen/include/xen/numa.h
index 6737ade864..e92f1355dd 100644
--- a/xen/include/xen/numa.h
+++ b/xen/include/xen/numa.h
@@ -2,6 +2,15 @@
 #define _XEN_NUMA_H
 
 #include <xen/mm-frame.h>
+#include <xen/errno.h>
+
+/* Defined in xen/sched.h; forward-declared here since numa.h is pulled in
+ * by domain.h before struct domain is declared. */
+struct domain;
+
+/* Defined in public/domctl.h; forward-declared here to avoid pulling in all
+ * of domctl.h from this low-level header. */
+struct xen_domctl_numa_op;
 
 #ifdef CONFIG_NUMA
 #include <xen/pdx.h>
-- 
2.53.0

