From 32e17c72460e13f0440d865a8221b4d2d3e9475e Mon Sep 17 00:00:00 2001
From: Julian Vetter <julian.vetter@vates.tech>
Date: Tue, 7 Jul 2026 15:20:30 +0200
Subject: [PATCH] tools/xenguest: create a guest device tree for ARM domains

xenopsd builds domains by exec'ing xenguest, not by linking against
libxl, so none of libxl's device-tree functions (i.e.,
libxl__prepare_dtb / libxl__arch_domain_finalise_hw_description in
tools/libs/light/libxl_arm.c) are available to it. Without a DTB,
xenguest has no way to describe memory, vcpus, the GIC, the Xen
hypervisor node, or the console/xenstore event channels to an ARM guest
kernel, so ARM domains could not boot via xenguest.

Add tools/xenguest/xg_dom_arm_fdt.c, a stripped-down port of libxl's DTB
construction:

 - build_arm_dtb() constructs a temporary tree (root, memory, vcpus,
   GIC, timer, chosen/bootargs, initrd placeholder, hypervisor grant-table
   node, optional PSCI) early, before guest memory is populated. The GIC
   node shape (GICv2 vs GICv3) is chosen from the domain's gic_version.
 - finalise_arm_dtb() patches in the real memory bank sizes and initrd
   addresses once those are known, just like
   libxl__arch_domain_finalise_hw_description().

This is a simplified version of libxl_arm.c: only a single grant-table
region is described in the /hypervisor node (no extended virtio
regions), and there is no support for PCI passthrough or extra DTB
overlay nodes.

Call both entry points from stub_xc_hvm_build() in xenguest_stubs.c,
called after xc_dom_parse_image() and after pvh_setup_mem()
respectively. Both call are guarded by __arm__/__aarch64__.

gic_version and clock_frequency are IN/OUT fields of
xen_arch_domainconfig, resolved by Xen at XEN_DOMCTL_createdomain time
(during xenopsd's earlier domain-creation step), but xenguest is a
separate process invoked later and has no access to that hypercall's
reply, so add arm_dtb_get_arch_config(), which re-fetches the same
struct for our already-created domid via
xc_domain_getinfo_single()/XEN_DOMCTL_getdomaininfo.

Update tools/xenguest/Makefile and xg_internal.h to build
xg_dom_arm_fdt.o and link -lfdt when CONFIG_ARM is set.

Signed-off-by: Julian Vetter <julian.vetter@vates.tech>
---
 tools/xenguest/Makefile         |   7 +-
 tools/xenguest/xenguest_stubs.c |  54 ++++
 tools/xenguest/xg_dom_arm_fdt.c | 457 ++++++++++++++++++++++++++++++++
 tools/xenguest/xg_internal.h    |   8 +
 4 files changed, 524 insertions(+), 2 deletions(-)
 create mode 100644 tools/xenguest/xg_dom_arm_fdt.c

diff --git a/tools/xenguest/Makefile b/tools/xenguest/Makefile
index 791a028839..e1d7f58cd2 100644
--- a/tools/xenguest/Makefile
+++ b/tools/xenguest/Makefile
@@ -9,6 +9,9 @@ CFLAGS += $(CFLAGS_libxentoolcore)
 
 PROGRAMS := xenguest
 
+OBJS-$(CONFIG_ARM) += xg_dom_arm_fdt.o
+LDLIBS-$(CONFIG_ARM) += -lfdt
+
 .PHONY: all
 all: build
 
@@ -27,9 +30,9 @@ vpath static_tables.c $(ACPI_PATH)/
 acpi:
 	$(MAKE) -C $(ACPI_PATH) ACPI_BUILD_DIR=$(CURDIR) DSDT_FILES="$(DSDT_FILES)"
 
-xenguest: xenguest.o xenguest_stubs.o xg_emu.o $(ACPI_OBJS)
+xenguest: xenguest.o xenguest_stubs.o xg_emu.o $(ACPI_OBJS) $(OBJS-y)
 	$(CC) $(CFLAGS) -o $@ $(LDFLAGS) $^ \
-		$(LDLIBS_libxentoollog) $(LDLIBS_libxenctrl) $(LDLIBS_libxenguest) $(LDLIBS_libxenstore) -ljson-c -pthread -lempserver
+		$(LDLIBS_libxentoollog) $(LDLIBS_libxenctrl) $(LDLIBS_libxenguest) $(LDLIBS_libxenstore) -ljson-c -pthread -lempserver $(LDLIBS-y)
 
 .PHONY: install
 install: build
diff --git a/tools/xenguest/xenguest_stubs.c b/tools/xenguest/xenguest_stubs.c
index 1fa3479543..3b383989a4 100644
--- a/tools/xenguest/xenguest_stubs.c
+++ b/tools/xenguest/xenguest_stubs.c
@@ -1590,6 +1590,39 @@ static void hvm_safety_check(struct flags *f, bool pod)
         xg_fatal("Shadow Paging and Nested Virtualisation are mutually exclusive\n");
 }
 
+#if defined(__arm__) || defined(__aarch64__)
+/*
+ * gic_version/clock_frequency are IN/OUT fields of xen_arch_domainconfig,
+ * fixed by Xen at XEN_DOMCTL_createdomain time (xenopsd's domain-creation
+ * step, which runs before xenguest is ever invoked). xenguest doesn't see
+ * that hypercall's output directly, so it re-fetches the same struct via
+ * XEN_DOMCTL_getdomaininfo for our already-created domid.
+ */
+static int arm_dtb_get_arch_config(unsigned int *gic_version,
+                                   uint32_t *clock_frequency,
+                                   unsigned int *xen_major,
+                                   unsigned int *xen_minor)
+{
+    xc_domaininfo_t info;
+    int ver;
+
+    if ( xc_domain_getinfo_single(xch, domid, &info) < 0 )
+        return -1;
+
+    *gic_version = info.arch_config.gic_version;
+    *clock_frequency = info.arch_config.clock_frequency;
+
+    ver = xc_version(xch, XENVER_version, NULL);
+    if ( ver < 0 )
+        return -1;
+
+    *xen_major = ver >> 16;
+    *xen_minor = ver & 0xffff;
+
+    return 0;
+}
+#endif
+
 int stub_xc_hvm_build(int mem_max_mib, int mem_start_mib,
                       const char *image_name, const char *cmdline,
                       const pvh_module *modules, int nmodules,
@@ -1663,12 +1696,33 @@ int stub_xc_hvm_build(int mem_max_mib, int mem_start_mib,
     if ( xc_dom_parse_image(dom) )
         failwith_oss_xc("xc_dom_parse_image");
 
+#if defined(__arm__) || defined(__aarch64__)
+    {
+        unsigned int gic_version, dtb_xen_major, dtb_xen_minor;
+        uint32_t clock_frequency;
+
+        if ( arm_dtb_get_arch_config(&gic_version, &clock_frequency,
+                                     &dtb_xen_major, &dtb_xen_minor) )
+            failwith_oss_xc("xc_domain_getinfo_single");
+
+        if ( build_arm_dtb(dom, f.vcpus, cmdline, nmodules > 0,
+                           gic_version, clock_frequency,
+                           dtb_xen_major, dtb_xen_minor) )
+            xg_fatal("xenguest: Failed to build device tree\n");
+    }
+#endif
+
     if ( is_pvh )
     {
         r = pvh_setup_mem(dom, mem_max_mib, mem_start_mib);
         if ( r )
             failwith_oss_xc("pvh_setup_mem");
 
+#if defined(__arm__) || defined(__aarch64__)
+        if ( finalise_arm_dtb(dom) )
+            xg_fatal("xenguest: Failed to finalise device tree\n");
+#endif
+
         r = xenguest_dom_load_acpi(dom, &f);
         if ( r )
             failwith_oss_xc("xenguest_dom_load_acpi");
diff --git a/tools/xenguest/xg_dom_arm_fdt.c b/tools/xenguest/xg_dom_arm_fdt.c
new file mode 100644
index 0000000000..aa2b15d29f
--- /dev/null
+++ b/tools/xenguest/xg_dom_arm_fdt.c
@@ -0,0 +1,457 @@
+/*
+ * Minimal ARM guest device-tree construction for xenguest.
+ *
+ * Ported from tools/libs/light/libxl_arm.c (libxl__prepare_dtb /
+ * libxl__arch_domain_finalise_hw_description), which xenguest does not
+ * go through -- xenopsd talks to xenguest directly instead of libxl, so
+ * none of libxl's device-tree synthesis is otherwise available here.
+ *
+ * Simplification vs libxl_arm.c: only a single grant-table region is
+ * described in the /hypervisor node (no extended virtio regions).
+ */
+
+#include <alloca.h>
+#include <assert.h>
+#include <inttypes.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libfdt.h>
+#include <xen/xen.h>
+#include <xen/device_tree_defs.h>
+#include <xen-tools/common-macros.h>
+
+#include "xg_internal.h"
+
+#define FDT_MAX_SIZE (1 << 20)
+
+/* Small leak-per-call helper: this builder runs once per domain build
+ * and then the process exits, so we don't bother freeing these. */
+static const char *xg_asprintf(const char *fmt, ...)
+{
+    char *buf;
+    va_list ap;
+
+    va_start(ap, fmt);
+    if ( vasprintf(&buf, fmt, ap) == -1 )
+        buf = NULL;
+    va_end(ap);
+
+    return buf;
+}
+
+typedef uint32_t be32;
+typedef be32 gic_interrupt[3];
+
+struct arm_arch_info {
+    const char *guest_type;
+    const char *timer_compat;
+    const char *cpu_compat;
+};
+
+static const struct arm_arch_info arm_arch_info[] = {
+    {"xen-3.0-armv7l",  "arm,armv7-timer", "arm,cortex-a15" },
+    {"xen-3.0-aarch64", "arm,armv8-timer", "arm,armv8" },
+};
+
+static const struct arm_arch_info *get_arm_arch_info(const struct xc_dom_image *dom)
+{
+    unsigned int i;
+
+    for ( i = 0; i < ARRAY_SIZE(arm_arch_info); i++ )
+        if ( !strcmp(dom->guest_type, arm_arch_info[i].guest_type) )
+            return &arm_arch_info[i];
+
+    return NULL;
+}
+
+static uint64_t compute_mpidr(unsigned int cpuid)
+{
+    /* See libxl__compute_mpdir(): reg must match the MPIDR's affinity
+     * bits, using AFF0/AFF1 which is enough for our vcpu counts. */
+    return (cpuid & 0x0f) | (((cpuid >> 4) & 0xff) << 8);
+}
+
+static void set_cell(be32 **cellp, int size, uint64_t val)
+{
+    int cells = size;
+
+    while ( size-- )
+    {
+        (*cellp)[size] = cpu_to_fdt32(val);
+        val >>= 32;
+    }
+
+    (*cellp) += cells;
+}
+
+static void set_range(be32 **cellp, int address_cells, int size_cells,
+                      uint64_t address, uint64_t size)
+{
+    set_cell(cellp, address_cells, address);
+    set_cell(cellp, size_cells, size);
+}
+
+static void set_interrupt(gic_interrupt interrupt, unsigned int irq,
+                          unsigned int cpumask, unsigned int level)
+{
+    be32 *cells = interrupt;
+    int is_ppi = (irq < 32);
+
+    assert(irq >= 16);
+    irq -= is_ppi ? 16 : 32;
+
+    set_cell(&cells, 1, is_ppi);
+    set_cell(&cells, 1, irq);
+    set_cell(&cells, 1, (cpumask << 8) | level);
+}
+
+static int fdt_property_compat(void *fdt, unsigned int nr_compat, ...)
+{
+    const char *compats[nr_compat];
+    size_t sz = 0;
+    char *compat, *p;
+    va_list ap;
+    unsigned int i;
+
+    va_start(ap, nr_compat);
+    for ( i = 0; i < nr_compat; i++ )
+    {
+        compats[i] = va_arg(ap, const char *);
+        sz += strlen(compats[i]) + 1;
+    }
+    va_end(ap);
+
+    p = compat = alloca(sz);
+    for ( i = 0; i < nr_compat; i++ )
+    {
+        strcpy(p, compats[i]);
+        p += strlen(compats[i]) + 1;
+    }
+
+    return fdt_property(fdt, "compatible", compat, sz);
+}
+
+static int fdt_property_interrupts(void *fdt, gic_interrupt *intr,
+                                   unsigned int num_irq)
+{
+    int res = fdt_property(fdt, "interrupts", intr, sizeof(intr[0]) * num_irq);
+
+    if ( res )
+        return res;
+
+    return fdt_property_cell(fdt, "interrupt-parent", GUEST_PHANDLE_GIC);
+}
+
+static int fdt_property_regs(void *fdt, unsigned int addr_cells,
+                             unsigned int size_cells, unsigned int num_regs, ...)
+{
+    uint32_t regs[num_regs * (addr_cells + size_cells)];
+    be32 *cells = &regs[0];
+    va_list ap;
+    unsigned int i;
+
+    va_start(ap, num_regs);
+    for ( i = 0; i < num_regs; i++ )
+    {
+        uint64_t base = addr_cells ? va_arg(ap, uint64_t) : 0;
+        uint64_t size = size_cells ? va_arg(ap, uint64_t) : 0;
+
+        set_range(&cells, addr_cells, size_cells, base, size);
+    }
+    va_end(ap);
+
+    return fdt_property(fdt, "reg", regs, sizeof(regs));
+}
+
+static int fdt_property_u32_val(void *fdt, const char *name, uint32_t val)
+{
+    uint32_t tmp = cpu_to_fdt32(val);
+
+    return fdt_property(fdt, name, &tmp, sizeof(tmp));
+}
+
+static int fdt_property_reg_placeholder(void *fdt, unsigned int addr_cells,
+                                        unsigned int size_cells,
+                                        unsigned int num_regs)
+{
+    uint32_t regs[num_regs * (addr_cells + size_cells)];
+    be32 *cells = &regs[0];
+    unsigned int i;
+
+    for ( i = 0; i < num_regs; i++ )
+        set_range(&cells, addr_cells, size_cells, 0, 0);
+
+    return fdt_property(fdt, "reg", regs, sizeof(regs));
+}
+
+/*
+ * Build a placeholder ARM device tree for `dom` and hand it to libxc via
+ * xc_dom_devicetree_mem(). Must run after xc_dom_parse_image() (need
+ * dom->guest_type) and before xc_dom_boot_mem_init() (which sizes the
+ * devicetree placement using dom->devicetree_size).
+ *
+ * Memory bank and initrd addresses are written as placeholders here and
+ * patched with real values later by finalise_arm_dtb(), once
+ * xc_dom_boot_mem_init() has computed them -- mirrors libxl's
+ * libxl__prepare_dtb() / libxl__arch_domain_finalise_hw_description()
+ * split.
+ */
+int build_arm_dtb(struct xc_dom_image *dom, unsigned int nr_vcpus,
+                  const char *cmdline, bool has_ramdisk,
+                  unsigned int gic_version, uint32_t clock_frequency,
+                  unsigned int xen_major, unsigned int xen_minor)
+{
+    const struct arm_arch_info *ainfo = get_arm_arch_info(dom);
+    const uint64_t bankbase[] = GUEST_RAM_BANK_BASES;
+    void *fdt = NULL;
+    size_t fdt_size = 0;
+    unsigned int i;
+
+    if ( !ainfo )
+        return -1;
+
+#define FDT(call)                                                     \
+    do {                                                              \
+        int fdt_res = (call);                                         \
+        if ( fdt_res == -FDT_ERR_NOSPACE && fdt_size < FDT_MAX_SIZE )  \
+            goto next_resize;                                         \
+        else if ( fdt_res < 0 )                                       \
+            return fdt_res;                                           \
+    } while ( 0 )
+
+    for ( ;; )
+    {
+next_resize:
+        fdt_size = fdt_size ? fdt_size << 1 : 4096;
+        fdt = realloc(fdt, fdt_size);
+        if ( !fdt )
+            return -1;
+
+        FDT(fdt_create(fdt, fdt_size));
+        FDT(fdt_finish_reservemap(fdt));
+        FDT(fdt_begin_node(fdt, ""));
+
+        FDT(fdt_property_string(fdt, "model",
+                                xg_asprintf("XENVM-%u.%u", xen_major, xen_minor)));
+        FDT(fdt_property_compat(fdt, 2,
+                                xg_asprintf("xen,xenvm-%u.%u", xen_major, xen_minor),
+                                "xen,xenvm"));
+        FDT(fdt_property_cell(fdt, "interrupt-parent", GUEST_PHANDLE_GIC));
+        FDT(fdt_property_cell(fdt, "#address-cells", GUEST_ROOT_ADDRESS_CELLS));
+        FDT(fdt_property_cell(fdt, "#size-cells", GUEST_ROOT_SIZE_CELLS));
+
+        /* /chosen */
+        FDT(fdt_begin_node(fdt, "chosen"));
+        FDT(fdt_property_string(fdt, "bootargs", cmdline));
+        if ( has_ramdisk )
+        {
+            uint64_t dummy = 0;
+
+            FDT(fdt_property(fdt, "linux,initrd-start", &dummy, sizeof(dummy)));
+            FDT(fdt_property(fdt, "linux,initrd-end", &dummy, sizeof(dummy)));
+        }
+        FDT(fdt_end_node(fdt));
+
+        /* /cpus */
+        FDT(fdt_begin_node(fdt, "cpus"));
+        FDT(fdt_property_cell(fdt, "#address-cells", 1));
+        FDT(fdt_property_cell(fdt, "#size-cells", 0));
+        for ( i = 0; i < nr_vcpus; i++ )
+        {
+            uint64_t mpidr_aff = compute_mpidr(i);
+
+            FDT(fdt_begin_node(fdt, xg_asprintf("cpu@%"PRIx64, mpidr_aff)));
+            FDT(fdt_property_string(fdt, "device_type", "cpu"));
+            FDT(fdt_property_compat(fdt, 1, ainfo->cpu_compat));
+            FDT(fdt_property_string(fdt, "enable-method", "psci"));
+            FDT(fdt_property_regs(fdt, 1, 0, 1, mpidr_aff));
+            FDT(fdt_end_node(fdt));
+        }
+        FDT(fdt_end_node(fdt));
+
+        /* /psci */
+        FDT(fdt_begin_node(fdt, "psci"));
+        FDT(fdt_property_compat(fdt, 3, "arm,psci-1.0", "arm,psci-0.2", "arm,psci"));
+        FDT(fdt_property_string(fdt, "method", "hvc"));
+        FDT(fdt_property_cell(fdt, "cpu_off", PSCI_cpu_off));
+        FDT(fdt_property_cell(fdt, "cpu_on", PSCI_cpu_on));
+        FDT(fdt_end_node(fdt));
+
+        /* /memory@... (placeholder, patched by finalise_arm_dtb) */
+        for ( i = 0; i < GUEST_RAM_BANKS; i++ )
+        {
+            FDT(fdt_begin_node(fdt, xg_asprintf("memory@%"PRIx64, bankbase[i])));
+            FDT(fdt_property_string(fdt, "device_type", "memory"));
+            FDT(fdt_property_regs(fdt, GUEST_ROOT_ADDRESS_CELLS,
+                                  GUEST_ROOT_SIZE_CELLS, 1, 0, 0));
+            FDT(fdt_end_node(fdt));
+        }
+
+        /* /interrupt-controller@... */
+        if ( gic_version == XEN_DOMCTL_CONFIG_GIC_V3 )
+        {
+            const uint64_t gicd_base = GUEST_GICV3_GICD_BASE;
+
+            FDT(fdt_begin_node(fdt, xg_asprintf("interrupt-controller@%"PRIx64,
+                                                gicd_base)));
+            FDT(fdt_property_compat(fdt, 1, "arm,gic-v3"));
+            FDT(fdt_property_cell(fdt, "#interrupt-cells", 3));
+            FDT(fdt_property_cell(fdt, "#address-cells", 0));
+            FDT(fdt_property(fdt, "interrupt-controller", NULL, 0));
+            FDT(fdt_property_regs(fdt, GUEST_ROOT_ADDRESS_CELLS, GUEST_ROOT_SIZE_CELLS,
+                                  2, gicd_base, (uint64_t)GUEST_GICV3_GICD_SIZE,
+                                  (uint64_t)GUEST_GICV3_GICR0_BASE,
+                                  (uint64_t)GUEST_GICV3_GICR0_SIZE));
+            FDT(fdt_property_cell(fdt, "linux,phandle", GUEST_PHANDLE_GIC));
+            FDT(fdt_property_cell(fdt, "phandle", GUEST_PHANDLE_GIC));
+            FDT(fdt_end_node(fdt));
+        }
+        else
+        {
+            const uint64_t gicd_base = GUEST_GICD_BASE;
+
+            FDT(fdt_begin_node(fdt, xg_asprintf("interrupt-controller@%"PRIx64,
+                                                gicd_base)));
+            FDT(fdt_property_compat(fdt, 2, "arm,cortex-a15-gic",
+                                    "arm,cortex-a9-gic"));
+            FDT(fdt_property_cell(fdt, "#interrupt-cells", 3));
+            FDT(fdt_property_cell(fdt, "#address-cells", 0));
+            FDT(fdt_property(fdt, "interrupt-controller", NULL, 0));
+            FDT(fdt_property_regs(fdt, GUEST_ROOT_ADDRESS_CELLS, GUEST_ROOT_SIZE_CELLS,
+                                  2, gicd_base, (uint64_t)GUEST_GICC_SIZE,
+                                  (uint64_t)GUEST_GICC_BASE, (uint64_t)GUEST_GICC_SIZE));
+            FDT(fdt_property_cell(fdt, "linux,phandle", GUEST_PHANDLE_GIC));
+            FDT(fdt_property_cell(fdt, "phandle", GUEST_PHANDLE_GIC));
+            FDT(fdt_end_node(fdt));
+        }
+
+        /* /timer */
+        {
+            gic_interrupt ints[3];
+
+            FDT(fdt_begin_node(fdt, "timer"));
+            FDT(fdt_property_compat(fdt, 1, ainfo->timer_compat));
+            set_interrupt(ints[0], GUEST_TIMER_PHYS_S_PPI, 0xf, DT_IRQ_TYPE_LEVEL_LOW);
+            set_interrupt(ints[1], GUEST_TIMER_PHYS_NS_PPI, 0xf, DT_IRQ_TYPE_LEVEL_LOW);
+            set_interrupt(ints[2], GUEST_TIMER_VIRT_PPI, 0xf, DT_IRQ_TYPE_LEVEL_LOW);
+            FDT(fdt_property_interrupts(fdt, ints, 3));
+            if ( clock_frequency )
+                FDT(fdt_property_u32_val(fdt, "clock-frequency", clock_frequency));
+            FDT(fdt_end_node(fdt));
+        }
+
+        /* /hypervisor (placeholder reg, patched by finalise_arm_dtb) */
+        {
+            gic_interrupt intr;
+
+            FDT(fdt_begin_node(fdt, "hypervisor"));
+            FDT(fdt_property_compat(fdt, 2,
+                                    xg_asprintf("xen,xen-%u.%u", xen_major, xen_minor),
+                                    "xen,xen"));
+            FDT(fdt_property_reg_placeholder(fdt, GUEST_ROOT_ADDRESS_CELLS,
+                                             GUEST_ROOT_SIZE_CELLS, 1));
+            set_interrupt(intr, GUEST_EVTCHN_PPI, 0xf, DT_IRQ_TYPE_LEVEL_LOW);
+            FDT(fdt_property_interrupts(fdt, &intr, 1));
+            FDT(fdt_end_node(fdt));
+        }
+
+        FDT(fdt_end_node(fdt));
+        FDT(fdt_finish(fdt));
+        break;
+    }
+#undef FDT
+
+    /*
+     * xc_dom_devicetree_mem() stores this pointer directly in
+     * dom->devicetree_blob (it does not copy the buffer), and
+     * finalise_arm_dtb()/xc_dom_build_image() read/write through it later
+     * -- so `fdt` must stay alive for the rest of the process. xenguest
+     * exits after building one domain, so we deliberately leak it.
+     */
+    return xc_dom_devicetree_mem(dom, fdt, fdt_totalsize(fdt));
+}
+
+static void finalise_one_node(void *fdt, const char *uname, uint64_t base,
+                              uint64_t size)
+{
+    char name[64];
+    int node;
+
+    snprintf(name, sizeof(name), "%s@%"PRIx64, uname, base);
+    node = fdt_path_offset(fdt, name);
+    assert(node > 0);
+
+    if ( size == 0 )
+        fdt_nop_node(fdt, node);
+    else
+    {
+        uint32_t regs[GUEST_ROOT_ADDRESS_CELLS + GUEST_ROOT_SIZE_CELLS];
+        be32 *cells = &regs[0];
+
+        set_range(&cells, GUEST_ROOT_ADDRESS_CELLS, GUEST_ROOT_SIZE_CELLS,
+                  base, size);
+        if ( fdt_setprop_inplace(fdt, node, "reg", regs, sizeof(regs)) )
+            assert(0);
+    }
+}
+
+/*
+ * Patch the real memory bank sizes and initrd location into the
+ * placeholder device tree built by build_arm_dtb(), once
+ * xc_dom_boot_mem_init() has computed them. Must run before
+ * xc_dom_build_image(), which copies dom->devicetree_blob verbatim into
+ * guest memory.
+ */
+int finalise_arm_dtb(struct xc_dom_image *dom)
+{
+    void *fdt = dom->devicetree_blob;
+    const uint64_t bankbase[] = GUEST_RAM_BANK_BASES;
+    unsigned int i;
+
+    if ( !fdt )
+        return 0;
+
+    if ( dom->modules[0].blob )
+    {
+        int chosen = fdt_path_offset(fdt, "/chosen");
+        uint64_t val;
+
+        assert(chosen > 0);
+
+        val = cpu_to_fdt64(dom->modules[0].seg.vstart);
+        if ( fdt_setprop_inplace(fdt, chosen, "linux,initrd-start",
+                                 &val, sizeof(val)) )
+            return -1;
+
+        val = cpu_to_fdt64(dom->modules[0].seg.vend);
+        if ( fdt_setprop_inplace(fdt, chosen, "linux,initrd-end",
+                                 &val, sizeof(val)) )
+            return -1;
+    }
+
+    /* Single grant-table-only region; no extended (virtio) regions. */
+    {
+        int offset = fdt_path_offset(fdt, "/hypervisor");
+        uint32_t regs[GUEST_ROOT_ADDRESS_CELLS + GUEST_ROOT_SIZE_CELLS];
+        be32 *cells = &regs[0];
+
+        assert(offset > 0);
+        set_range(&cells, GUEST_ROOT_ADDRESS_CELLS, GUEST_ROOT_SIZE_CELLS,
+                  GUEST_GNTTAB_BASE, GUEST_GNTTAB_SIZE);
+        if ( fdt_setprop_inplace(fdt, offset, "reg", regs, sizeof(regs)) )
+            return -1;
+    }
+
+    for ( i = 0; i < GUEST_RAM_BANKS; i++ )
+    {
+        uint64_t size = (uint64_t)dom->rambank_size[i] << XC_DOM_PAGE_SHIFT(dom);
+
+        finalise_one_node(fdt, "/memory", bankbase[i], size);
+    }
+
+    return 0;
+}
