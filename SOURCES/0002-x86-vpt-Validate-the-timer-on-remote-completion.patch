From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tu Dinh <ngoc-tu.dinh@vates.tech>
Date: Thu, 22 Oct 2026 18:04:38 +0200
Subject: [PATCH] x86/vpt: Validate the timer on remote completion

A platform timer interrupt can run on another vCPU before pt_update_irq
finishes its remote completion path. The guest can then reprogram the
same periodic_time object before it's fired. A check based on pointer
equivalence will accept the new arm and complete it as if it were the
previously injected arm.

Identify each published create_periodic_time() lifetime with a
generation number. Only complete a pending arm if the generations match.

Signed-off-by: Tu Dinh <ngoc-tu.dinh@vates.tech>

diff --git a/xen/arch/x86/hvm/vpt.c b/xen/arch/x86/hvm/vpt.c
index cc8ef34f5bcd..2682aa87e091 100644
--- a/xen/arch/x86/hvm/vpt.c
+++ b/xen/arch/x86/hvm/vpt.c
@@ -329,7 +329,7 @@ int pt_update_irq(struct vcpu *v)
 {
     struct list_head *head = &v->arch.hvm.tm_list;
     struct periodic_time *pt, *temp, *earliest_pt;
-    uint64_t max_lag;
+    uint64_t max_lag, generation;
     int irq, pt_vector = -1;
     bool level;
 
@@ -368,6 +368,7 @@ int pt_update_irq(struct vcpu *v)
     }
 
     earliest_pt->irq_issued = 1;
+    generation = earliest_pt->generation;
     irq = earliest_pt->irq;
     level = earliest_pt->level;
 
@@ -424,6 +425,9 @@ int pt_update_irq(struct vcpu *v)
         list_for_each_entry ( pt, &v->arch.hvm.tm_list, list )
             if ( pt == earliest_pt )
             {
+                if ( pt->generation != generation )
+                    break;
+
                 pt_irq_fired(v, pt);
                 cb = pt->cb;
                 cb_priv = pt->priv;
@@ -562,6 +566,7 @@ void create_periodic_time(
     set_timer(&pt->timer, pt->scheduled);
 
     pt_vcpu_lock(v);
+    pt->generation++;
     pt->on_list = 1;
     list_add(&pt->list, &v->arch.hvm.tm_list);
     pt_vcpu_unlock(v);
diff --git a/xen/arch/x86/include/asm/hvm/vpt.h b/xen/arch/x86/include/asm/hvm/vpt.h
index 74c0cedd11cc..15917e3cb745 100644
--- a/xen/arch/x86/include/asm/hvm/vpt.h
+++ b/xen/arch/x86/include/asm/hvm/vpt.h
@@ -44,6 +44,7 @@ struct periodic_time {
     u8 irq;
     struct vcpu *vcpu;          /* vcpu timer interrupt delivers to */
     u32 pending_intr_nr;        /* pending timer interrupts */
+    u64 generation;             /* distinguish two arms of the same timer */
     u64 period;                 /* frequency in ns */
     s_time_t scheduled;         /* scheduled timer interrupt */
     u64 last_plt_gtime;         /* platform time when last IRQ is injected */
